{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "/backend/mysql/**",
      "/backend/**/*.php",
      "/backend/Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/state",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
